<!--  Root is DeclarationFormView: leave-confirm + wipe. Binds the real OrgUnitDeclarationViewModel.  -->

<views:DeclarationFormView

    x:Class="AST.Views.Iam.OrgUnit.OrgUnitDeclarationView"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:controls="clr-namespace:AST.Controls;assembly=AST.UI"

    xmlns:local="clr-namespace:AST.Views.Iam.OrgUnit"

    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

    xmlns:views="clr-namespace:AST.Views"

    Language="vi-VN">



    <views:DeclarationFormView.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="pack://application:,,,/AST;component/Views/Iam/OrgUnit/OrgUnitDeclarationSharedStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <Style

                x:Key="EqualActionButton"

                BasedOn="{StaticResource {x:Type ui:Button}}"

                TargetType="ui:Button">

                <Setter Property="Width" Value="110" />

                <Setter Property="Margin" Value="0,0,8,0" />

            </Style>

            <Style

                x:Key="EqualHistoryButton"

                BasedOn="{StaticResource {x:Type ui:Button}}"

                TargetType="ui:Button">

                <Setter Property="Width" Value="128" />

                <Setter Property="MinWidth" Value="128" />

                <Setter Property="MaxWidth" Value="128" />

                <Setter Property="Margin" Value="0,0,12,0" />

                <Setter Property="Appearance" Value="Secondary" />

                <Setter Property="HorizontalContentAlignment" Value="Center" />

            </Style>

            <Style x:Key="OrgUnitExpandToggle" TargetType="ToggleButton">

                <Setter Property="Focusable" Value="False" />

                <Setter Property="Width" Value="16" />

                <Setter Property="Height" Value="16" />

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="ToggleButton">

                            <Border Background="Transparent">

                                <Path

                                    x:Name="Arrow"

                                    Width="8"

                                    Height="8"

                                    Data="M 0,0 L 4,4 L 0,8 Z"

                                    Fill="{DynamicResource TreeViewItemForeground}"

                                    Stretch="Uniform" />

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsChecked" Value="True">

                                    <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,0 L 4,4 Z" />

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>

            <!--

                Hover via header Border.IsMouseOver only — not TreeViewItem.IsMouseOver (ancestors light up).

                Keep x:Name=Expander for OrgUnitTreeViewItem expand≠select guard.

            -->

            <Style

                x:Key="OrgUnitTreeItemStyle"

                BasedOn="{StaticResource {x:Type TreeViewItem}}"

                TargetType="{x:Type local:OrgUnitTreeViewItem}">

                <Setter Property="Background" Value="Transparent" />

                <Setter Property="BorderBrush" Value="Transparent" />

                <Setter Property="Padding" Value="4,2" />

                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}" />

                <Setter Property="Template">

                    <Setter.Value>

                        <ControlTemplate TargetType="{x:Type local:OrgUnitTreeViewItem}">

                            <Grid Background="Transparent" SnapsToDevicePixels="True">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="*" />

                                </Grid.RowDefinitions>

                                <Border

                                    x:Name="Bd"

                                    Grid.Row="0"

                                    Padding="{TemplateBinding Padding}"

                                    Background="Transparent"

                                    BorderBrush="Transparent"

                                    BorderThickness="0"

                                    CornerRadius="{DynamicResource ControlCornerRadius}"

                                    SnapsToDevicePixels="True">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" MinWidth="19" />

                                            <ColumnDefinition Width="*" />

                                        </Grid.ColumnDefinitions>

                                        <Border

                                            x:Name="ActiveRectangle"

                                            Width="3"

                                            Height="16"

                                            Margin="0,0,4,0"

                                            HorizontalAlignment="Left"

                                            VerticalAlignment="Center"

                                            Background="{DynamicResource TreeViewItemSelectionIndicatorForeground}"

                                            CornerRadius="2"

                                            Visibility="Collapsed" />

                                        <ToggleButton

                                            x:Name="Expander"

                                            Grid.Column="0"

                                            Margin="4,0,4,0"

                                            ClickMode="Press"

                                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"

                                            Style="{StaticResource OrgUnitExpandToggle}" />

                                        <ContentPresenter

                                            x:Name="PART_Header"

                                            Grid.Column="1"

                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"

                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"

                                            ContentSource="Header"

                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                                    </Grid>

                                </Border>

                                <ItemsPresenter

                                    x:Name="ItemsHost"

                                    Grid.Row="1"

                                    Margin="16,0,0,0"

                                    Visibility="Collapsed" />

                            </Grid>

                            <ControlTemplate.Triggers>

                                <Trigger Property="HasItems" Value="False">

                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />

                                </Trigger>

                                <Trigger Property="IsExpanded" Value="True">

                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />

                                </Trigger>

                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />

                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">

                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeViewItemBackgroundSelected}" />

                                    <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>

                </Setter>

            </Style>

        </ResourceDictionary>

    </views:DeclarationFormView.Resources>



    <Grid>

        <controls:AstScreen

            Title="Khai báo đơn vị"

            Icon="BuildingMultiple24"

            Message="{Binding StatusMessage}"

            Severity="{Binding Severity}"

            Style="{StaticResource AstScreen}">



            <Grid>

                <Grid.RowDefinitions>

                    <!--

                        Top row = Auto: height driven by DeclarationCard content.

                        TreeCard defaults to VerticalAlignment=Stretch, so it fills that same Auto row height —

                        no ElementName binding needed for the two cards to share one bottom edge.

                        History takes the leftover (*); 16 = default inter-card gap (same as column gap).

                    -->

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="16" />

                    <RowDefinition Height="*" MinHeight="180" />

                </Grid.RowDefinitions>



                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" MinWidth="260" />

                        <ColumnDefinition Width="16" />

                        <ColumnDefinition Width="1.6*" MinWidth="360" />

                    </Grid.ColumnDefinitions>



                    <!--  (1) Tree — default Stretch fills the Auto row's height, so it shares DeclarationCard's bottom edge without an ElementName binding.  -->

                    <Border

                        x:Name="TreeCard"

                        Grid.Column="0"

                        PreviewMouseLeftButtonDown="OnTreePanelPreviewMouseLeftButtonDown"

                        Style="{StaticResource AstCard}">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <controls:AstSectionHeader

                                Grid.Row="0"

                                Icon="Organization24"

                                Text="Danh mục đơn vị" />



                            <Grid

                                Grid.Row="1"

                                Margin="0,12,0,8"

                                VerticalAlignment="Center">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <TextBlock

                                    Grid.Column="0"

                                    Margin="0,0,8,0"

                                    Style="{StaticResource AstInlineFieldLabel}"

                                    Text="Ngày xem" />

                                <RadioButton

                                    Grid.Column="1"

                                    Margin="0,0,6,0"

                                    VerticalAlignment="Center"

                                    Checked="OnTreeAsOfTodayChecked"

                                    Content="Hôm nay"

                                    GroupName="TreeAsOf"

                                    IsChecked="{Binding Chrome.TreeAsOfToday, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}, Mode=TwoWay}"

                                    PreviewKeyDown="OnTreeAsOfRadioPreviewKeyDown"

                                    PreviewMouseLeftButtonDown="OnTreeAsOfRadioPreviewMouseDown"

                                    Style="{StaticResource CompactRadioButton}" />

                                <RadioButton

                                    Grid.Column="2"

                                    VerticalAlignment="Center"

                                    Checked="OnTreeAsOfSpecificChecked"

                                    Content="Ngày cụ thể"

                                    GroupName="TreeAsOf"

                                    IsChecked="{Binding Chrome.TreeAsOfSpecific, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}, Mode=TwoWay}"

                                    PreviewKeyDown="OnTreeAsOfRadioPreviewKeyDown"

                                    PreviewMouseLeftButtonDown="OnTreeAsOfRadioPreviewMouseDown"

                                    Style="{StaticResource CompactRadioButton}" />

                                <controls:AstDateBox

                                    Grid.Column="3"

                                    Margin="6,0,0,0"

                                    VerticalAlignment="Center"

                                    Date="{Binding Chrome.TreeAsOfDate, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}, Mode=TwoWay}"

                                    IsEnabled="{Binding Chrome.TreeAsOfSpecific, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}}"

                                    ShowCalendarGlyph="True"

                                    Style="{StaticResource AstDateBox}"

                                    Today="{Binding Chrome.BusinessToday, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}}" />

                            </Grid>



                            <!-- IsTabStop=False: TreeView's default chrome tab-stop is not operable here

                                 (selection is header-click → SelectionRequested, not GotFocus). Tab must

                                 skip the outer frame and continue to the next real input/control. -->

                            <local:OrgUnitTreeView

                                x:Name="OrgUnitTree"

                                Grid.Row="2"

                                BorderThickness="0"

                                IsTabStop="False"

                                ItemContainerStyle="{StaticResource OrgUnitTreeItemStyle}"

                                ItemsSource="{Binding TreeRoots}">

                                <local:OrgUnitTreeView.ItemTemplate>

                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">

                                        <TextBlock Style="{StaticResource AstBodySmallText}" Text="{Binding Label}" />

                                    </HierarchicalDataTemplate>

                                </local:OrgUnitTreeView.ItemTemplate>

                            </local:OrgUnitTreeView>

                        </Grid>

                    </Border>



                    <!--  (2) Declaration — content height drives TreeCard + top row.  -->

                    <Border

                        x:Name="DeclarationCard"

                        Grid.Column="2"

                        VerticalAlignment="Top"

                        Style="{StaticResource AstCard}">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>



                            <Grid Grid.Row="0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <controls:AstSectionHeader

                                    Grid.Column="0"

                                    Icon="DocumentEdit24"

                                    Text="Khai báo thông tin" />

                                <controls:AstVersionStatus

                                    Grid.Column="1"

                                    VerticalAlignment="Center"

                                    Status="{Binding Status}"

                                    Style="{StaticResource AstVersionStatus}" />

                            </Grid>



                            <!--

                                Fields + action bar on one surface. Card bottom inset = AstCardPadding (16)

                                = Margin above the button row (same rhythm as AstFieldLabel clusters).

                            -->

                            <StackPanel Grid.Row="1" Margin="0,12,0,0">

                                <controls:AstEffectivePeriod

                                    IsEnabled="{Binding IsEffectivePeriodEnabled}"

                                    IsUndetermined="{Binding IsUndetermined, Mode=TwoWay}"

                                    Today="{Binding Chrome.BusinessToday, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}}"

                                    From="{Binding EffectiveFrom, Mode=TwoWay}"

                                    To="{Binding EffectiveTo, Mode=TwoWay}">

                                    <controls:AstEffectivePeriod.Style>

                                        <Style BasedOn="{StaticResource AstEffectivePeriod}" TargetType="{x:Type controls:AstEffectivePeriod}">

                                            <Setter Property="IsEnabled" Value="False" />

                                            <Setter Property="IsFromEnabled" Value="True" />

                                            <Setter Property="IsUndeterminedEnabled" Value="True" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Mode}" Value="Adding">

                                                    <Setter Property="IsEnabled" Value="True" />

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Mode}" Value="Editing">

                                                    <Setter Property="IsEnabled" Value="True" />

                                                </DataTrigger>

                                                <!--  Closing: EP on; From locked; undetermined locked off (must enter To).  -->

                                                <DataTrigger Binding="{Binding Mode}" Value="Closing">

                                                    <Setter Property="IsEnabled" Value="True" />

                                                    <Setter Property="IsFromEnabled" Value="False" />

                                                    <Setter Property="IsUndeterminedEnabled" Value="False" />

                                                </DataTrigger>

                                                <!--  Closing + cancel-plan branch: strip off. IsEnabled bound on the element (IsEffectivePeriodEnabled), which derives the branch from VersionCloseRules (From >= today), not from the Status label.  -->

                                            </Style.Triggers>

                                        </Style>

                                    </controls:AstEffectivePeriod.Style>

                                </controls:AstEffectivePeriod>



                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="16" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <controls:AstField

                                        Grid.Column="0"

                                        Label="Đơn vị cha"

                                        Style="{StaticResource AstField}">

                                        <controls:AstOrgUnitPicker

                                            DisplayText="{Binding Chrome.ParentDisplayText, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}}"

                                            Items="{Binding ParentCandidates}"

                                            Mode="{Binding Chrome.ParentMode, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}}"

                                            SelectedOrgUnitId="{Binding ParentId, Mode=TwoWay}"

                                            Style="{StaticResource AstOrgUnitPicker}" />

                                    </controls:AstField>

                                    <controls:AstField

                                        Grid.Column="2"

                                        Label="Mã đơn vị"

                                        Style="{StaticResource AstField}">

                                        <ui:TextBox CharacterCasing="Upper" Text="{Binding OrgCode, UpdateSourceTrigger=PropertyChanged}">

                                            <ui:TextBox.Style>

                                                <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">

                                                    <Setter Property="IsEnabled" Value="False" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Mode}" Value="Adding">

                                                            <Setter Property="IsEnabled" Value="True" />

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Mode}" Value="Editing">

                                                            <Setter Property="IsEnabled" Value="True" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </ui:TextBox.Style>

                                        </ui:TextBox>

                                    </controls:AstField>

                                </Grid>



                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="16" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <controls:AstField

                                        Grid.Column="0"

                                        Label="Tên đầy đủ"

                                        Style="{StaticResource AstField}">

                                        <ui:TextBox Text="{Binding OrgNameFullVn, UpdateSourceTrigger=PropertyChanged}">

                                            <ui:TextBox.Style>

                                                <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">

                                                    <Setter Property="IsEnabled" Value="False" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Mode}" Value="Adding">

                                                            <Setter Property="IsEnabled" Value="True" />

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Mode}" Value="Editing">

                                                            <Setter Property="IsEnabled" Value="True" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </ui:TextBox.Style>

                                        </ui:TextBox>

                                    </controls:AstField>

                                    <controls:AstField

                                        Grid.Column="2"

                                        Label="Tên viết tắt"

                                        Style="{StaticResource AstField}">

                                        <ui:TextBox Text="{Binding OrgNameShortVn, UpdateSourceTrigger=PropertyChanged}">

                                            <ui:TextBox.Style>

                                                <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">

                                                    <Setter Property="IsEnabled" Value="False" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Mode}" Value="Adding">

                                                            <Setter Property="IsEnabled" Value="True" />

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Mode}" Value="Editing">

                                                            <Setter Property="IsEnabled" Value="True" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </ui:TextBox.Style>

                                        </ui:TextBox>

                                    </controls:AstField>

                                </Grid>



                                <Grid

                                    Height="28"

                                    Margin="0,16,0,0"

                                    VerticalAlignment="Center">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0">

                                        <Run Text="Thông tin bổ sung: " />

                                        <Run FontWeight="SemiBold" Text="{Binding Chrome.SupplementalProgressText, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}, Mode=OneWay}" />

                                        <TextBlock.Style>

                                            <Style BasedOn="{StaticResource AstInlineFieldLabel}" TargetType="TextBlock">

                                                <Setter Property="Foreground" Value="{DynamicResource AstErrorBrush}" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Chrome.SupplementalProgressMajority, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}}" Value="True">

                                                        <Setter Property="Foreground" Value="{DynamicResource AstSuccessBrush}" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                    <ui:Button

                                        Grid.Column="1"

                                        Width="28"

                                        Height="28"

                                        Margin="8,0,0,0"

                                        Padding="0"

                                        VerticalAlignment="Center"

                                        Click="OnSupplementalClick"

                                        IsEnabled="{Binding CanOpenSupplemental}"

                                        Style="{StaticResource AstInlineIconButton}"

                                        ToolTip="Khai báo thông tin bổ sung">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="Edit24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                </Grid>



                                <controls:AstField Label="Ghi chú" Style="{StaticResource AstField}">

                                    <ui:TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}">

                                        <ui:TextBox.Style>

                                            <Style BasedOn="{StaticResource {x:Type ui:TextBox}}" TargetType="ui:TextBox">

                                                <Setter Property="IsEnabled" Value="False" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Mode}" Value="Adding">

                                                        <Setter Property="IsEnabled" Value="True" />

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Mode}" Value="Editing">

                                                        <Setter Property="IsEnabled" Value="True" />

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Mode}" Value="Closing">

                                                        <Setter Property="IsEnabled" Value="True" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </ui:TextBox.Style>

                                    </ui:TextBox>

                                </controls:AstField>



                                <!--

                                    §2.7.10 matrix via Command.CanExecute only — all five always visible;

                                    disable (do not collapse) when the settled Can* predicate is false.

                                -->

                                <StackPanel HorizontalAlignment="Right" Style="{StaticResource AstActionBar}">

                                    <ui:Button

                                        Appearance="Secondary"

                                        Command="{Binding BeginAddCommand}"

                                        Content="Thêm"

                                        Style="{StaticResource EqualActionButton}">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="Add24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                    <ui:Button

                                        Appearance="Secondary"

                                        Command="{Binding BeginEditCommand}"

                                        Content="Sửa"

                                        Style="{StaticResource EqualActionButton}">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="Edit24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                    <ui:Button

                                        Appearance="Secondary"

                                        Command="{Binding BeginCloseCommand}"

                                        Content="Đóng"

                                        Style="{StaticResource EqualActionButton}">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="PanelLeftContract24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                    <ui:Button

                                        Appearance="Secondary"

                                        Command="{Binding CancelCommand}"

                                        Content="Hủy"

                                        Style="{StaticResource EqualActionButton}">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="Dismiss24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                    <ui:Button

                                        Margin="0"

                                        Appearance="Primary"

                                        Command="{Binding SaveCommand}"

                                        Content="Lưu"

                                        Style="{StaticResource EqualActionButton}">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="Save24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                </StackPanel>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>



                <!--  (3) History  -->

                <Border Grid.Row="2" Style="{StaticResource AstCard}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>



                        <StackPanel

                            Grid.Row="0"

                            Margin="0,0,0,8"

                            controls:Spacing.Between="{StaticResource AstFieldGap}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <controls:AstSectionHeader

                                    Grid.Column="0"

                                    Icon="History24"

                                    Text="Lịch sử khai báo" />

                                <StackPanel

                                    Grid.Column="1"

                                    VerticalAlignment="Center"

                                    Orientation="Horizontal">

                                    <ui:Button

                                        Click="OnHistoryRefreshClick"

                                        Content="Làm mới"

                                        Style="{StaticResource EqualHistoryButton}"

                                        ToolTip="Làm mới">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="ArrowSync24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                    <ui:Button

                                        Click="OnHistoryShowAllClick"

                                        Content="Hiện tất cả"

                                        Style="{StaticResource EqualHistoryButton}"

                                        ToolTip="Hiện tất cả">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="FilterDismiss24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                    <ui:Button

                                        Margin="0"

                                        Click="OnHistoryViewClick"

                                        Content="Xem"

                                        IsEnabled="{Binding Chrome.CanViewHistory, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}}"

                                        Style="{StaticResource EqualHistoryButton}"

                                        ToolTip="Xem">

                                        <ui:Button.Icon>

                                            <ui:SymbolIcon Symbol="Eye24" />

                                        </ui:Button.Icon>

                                    </ui:Button>

                                </StackPanel>

                            </Grid>

                            <ui:TextBox

                                PlaceholderText="Tìm theo mã, tên, người ghi nhận, lý do..."

                                Text="{Binding HistoryFilterText, UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>



                        <DataGrid

                            Grid.Row="1"

                            HorizontalAlignment="Stretch"

                            IsSynchronizedWithCurrentItem="False"

                            ItemsSource="{Binding Chrome.HistoryRowsView, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}}"

                            ScrollViewer.HorizontalScrollBarVisibility="Auto"

                            SelectedItem="{Binding Chrome.SelectedHistoryRow, RelativeSource={RelativeSource AncestorType={x:Type local:OrgUnitDeclarationView}}, Mode=TwoWay}"

                            Style="{StaticResource AstDataGrid}">

                            <DataGrid.Columns>

                                <DataGridTextColumn

                                    Width="90"

                                    Binding="{Binding FromText}"

                                    Header="Từ ngày" />

                                <DataGridTextColumn

                                    Width="120"

                                    Binding="{Binding ToText}"

                                    Header="Đến ngày" />

                                <DataGridTextColumn

                                    Width="130"

                                    Binding="{Binding RecordedAtText}"

                                    Header="Ngày ghi" />

                                <DataGridTextColumn

                                    Width="110"

                                    Binding="{Binding StatusText}"

                                    Header="Tình trạng">

                                    <DataGridTextColumn.ElementStyle>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource VersionStatusToBrush}}" />

                                        </Style>

                                    </DataGridTextColumn.ElementStyle>

                                </DataGridTextColumn>

                                <DataGridTextColumn

                                    Width="100"

                                    Binding="{Binding OrgCode}"

                                    Header="Mã đơn vị" />

                                <DataGridTextColumn

                                    Width="176"

                                    Binding="{Binding NameFull}"

                                    Header="Tên đầy đủ" />

                                <DataGridTextColumn

                                    Width="110"

                                    Binding="{Binding NameShort}"

                                    Header="Tên tắt" />

                                <DataGridTextColumn

                                    Width="160"

                                    Binding="{Binding ParentLabel}"

                                    Header="Đơn vị cha" />

                                <DataGridTextColumn

                                    Width="90"

                                    Binding="{Binding Operation}"

                                    Header="Thao tác" />

                                <DataGridTextColumn

                                    Width="90"

                                    Binding="{Binding RecordedBy}"

                                    Header="Người ghi" />

                                <DataGridTextColumn

                                    Width="180"

                                    Binding="{Binding Reason}"
                                    Header="Ghi chú" />

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </controls:AstScreen>



        <!--  Supplemental overlay (local chrome — AstDialog has no custom-content builder yet).  -->

        <Border

            x:Name="SupplementalOverlay"

            Background="#80000000"

