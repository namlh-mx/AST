<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Screen-A–local compact radio (tree as-of + supplemental 2/3 cấp). Shared by
        OrgUnitDeclarationView and OrgUnitSupplementalDialog so the template does not drift.
        Not a registry shared component — both consumers are this screen only.
    -->
    <Style x:Key="CompactRadioButton" TargetType="RadioButton">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" Padding="0,2">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Grid
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="Outer"
                                    Fill="Transparent"
                                    Stroke="{DynamicResource AstOutlineBrush}"
                                    StrokeThickness="1.5" />
                                <Ellipse
                                    x:Name="Inner"
                                    Width="7"
                                    Height="7"
                                    Fill="{DynamicResource AstPrimaryBrush}"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource AstPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
