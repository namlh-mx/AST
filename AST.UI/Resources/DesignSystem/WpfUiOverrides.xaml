<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Global brand retint of WPF-UI's own theme brushes: overriding these keys makes stock WPF-UI control
        templates (text + success/critical semantics) adopt the AST palette under the Light theme.
    -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1a1c1c" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#605e5c" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#ba1a1a" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#00674f" />

    <!--
        Window surface = the warm AST background (#F0EEEA), not WPF-UI's default cool white. Overriding these two
        keys (the window/backdrop base color) plus WindowBackdropType="None" on the shell removes the bluish Mica
        tint. Softened from #FAF9F8 to #F0EEEA (requester F5) so the near-white page is easier on the eyes while
        the #FFFFFF cards still stand out. Keep in sync with AstSurfaceBrush in Palette.xaml.
    -->
    <Color x:Key="ApplicationBackgroundColor">#F0EEEA</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F0EEEA" />

    <!--
        Sidebar NavigationViewItem interactive states, now mapped to VISIBLE brand tints (previously subtle
        greys that read as "unchanged" against the default): hover (#f6e9eb, a light pink-tinted brand wash),
        pressed (#f0d9dc, a slightly deeper pink) with the brand foreground (#89002a) on hover/pressed so the
        interaction clearly reads as branded, over a constant resting foreground (#1a1c1c). Selected background
        (#ffe9ea, a soft brand pink — deliberately lighter than the old #ffdadb, which read as glaring) is the
        active-leaf accent: MainWindow code-behind sets IsActive=true on the shown leaf, so the stock template's
        IsActive trigger paints this key (still distinct from the hover wash #f6e9eb). Overriding these WPF-UI
        keys keeps the stock NavigationViewItem template while restyling its state colors — no custom template.
    -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#f6e9eb" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#f0d9dc" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#ffe9ea" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1a1c1c" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#89002a" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#89002a" />

    <!--
        TabItem (#6) SELECTED-state brand mapping. WPF-UI 4.3's stock TabControl/TabItem implicit style drives
        the selected header via these theme keys: selected background (#ffdadb, brand light-pink), selected
        foreground (#89002a, brand primary) and the selected-item accent border (#ae1c3e, brand accent). The
        unselected header background is left at the WPF-UI default. NOTE: hover/animation is INTENTIONALLY NOT
        added — WPF-UI 4.3's TabItem MouseOver visual state is empty, so a native hover would require a custom
        ControlTemplate, which is out of the locked "brand colours only, keep built-in shape" (Level-2) scope.
    -->
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#ffdadb" />
    <SolidColorBrush x:Key="TabViewItemForegroundSelected" Color="#89002a" />
    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#ae1c3e" />
</ResourceDictionary>
