<UserControl
    x:Class="AST.Views.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="{StaticResource AstPagePadding}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource AstContentMaxWidthText}" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource AstPageTitle}" Text="Trợ giúp" />
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource AstBodyMediumText}"
                Text="AST là ứng dụng dùng chung chạy trực tiếp từ ổ đĩa mạng. Trạng thái kết nối cơ sở dữ liệu hiển thị ở thanh trạng thái phía trên."
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,12,0,0"
                Style="{StaticResource AstBodyMediumText}"
                Text="Nếu ứng dụng báo chưa kết nối, vui lòng liên hệ quản trị viên. Quản trị viên xác thực bằng khóa bí mật (USB) trong mục Cấu hình để khai báo thông số kết nối."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
