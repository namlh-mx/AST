<UserControl
    x:Class="AST.Views.Iam.OrgUnit.OrgUnitSupplementalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AST.Controls;assembly=AST.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AST;component/Views/Iam/OrgUnit/OrgUnitDeclarationSharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style
                x:Key="SupplementalInlineLabel"
                BasedOn="{StaticResource AstFieldLabel}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--
                Keep dialog fields at designed column width: star columns must not grow with typed text
                (WPF TextBox DesiredWidth otherwise expands *). Local only — does not change shared ui:TextBox.
            -->
            <Style
                x:Key="SupplementalFixedTextBox"
                BasedOn="{StaticResource {x:Type ui:TextBox}}"
                TargetType="ui:TextBox">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            </Style>
            <Style
                x:Key="SupplementalDialogButton"
                BasedOn="{StaticResource {x:Type ui:Button}}"
                TargetType="ui:Button">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Width="780"
        Padding="16"
        Background="{DynamicResource AstSurfaceCardBrush}"
        BorderBrush="{DynamicResource AstOutlineBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <DockPanel>
            <StackPanel
                HorizontalAlignment="Right"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                Style="{StaticResource AstActionBar}">
                <ui:Button
                    x:Name="SaveButton"
                    Appearance="Primary"
                    Click="OnSaveClick"
                    Content="Lưu"
                    Style="{StaticResource SupplementalDialogButton}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    x:Name="EditButton"
                    Appearance="Secondary"
                    Click="OnEditClick"
                    Content="Sửa"
                    Style="{StaticResource SupplementalDialogButton}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Edit24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Margin="0"
                    Appearance="Secondary"
                    Click="OnCloseClick"
                    Content="Đóng"
                    Style="{StaticResource SupplementalDialogButton}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
            <StackPanel controls:Spacing.Between="{StaticResource AstFieldGap}" Grid.IsSharedSizeScope="True">
                <controls:AstSectionHeader Icon="ClipboardTextEdit24" Text="Thông tin bổ sung" />

                <!--
                    Shared label column (SharedSizeGroup) so every field row's first input
                    (Mã số / EN full / Số nhà / Điện thoại) shares the same left edge.
                    Star columns MinWidth=0 + SupplementalFixedTextBox keep designed widths.
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SupplementalFieldLabel" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource SupplementalInlineLabel}"
                        Text="Mã số kinh doanh" />
                    <ui:TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        MaxLength="14"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding BusinessNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource SupplementalInlineLabel}"
                        Text="Tên tiếng Anh" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Tên đầy đủ"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding NameFullEn, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="3"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Tên viết tắt"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding NameShortEn, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SupplementalFieldLabel" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource SupplementalInlineLabel}"
                        Text="Địa chỉ" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="7"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <RadioButton
                            x:Name="Level2Radio"
                            Margin="0,0,8,0"
                            Checked="OnLevel2Checked"
                            Content="2 cấp"
                            GroupName="AdminLevel"
                            IsChecked="{Binding IsLevel2, Mode=OneWay}"
                            IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource CompactRadioButton}" />
                        <RadioButton
                            x:Name="Level3Radio"
                            Checked="OnLevel3Checked"
                            Content="3 cấp"
                            GroupName="AdminLevel"
                            IsChecked="{Binding IsLevel3, Mode=OneWay}"
                            IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource CompactRadioButton}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource SupplementalInlineLabel}"
                        Text="Tiếng Việt" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Số nhà, đường"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding AddrLineVn, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="3"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Xã, phường"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding AddrWardVn, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="5"
                        IsEnabled="{Binding DistrictEnabled}"
                        PlaceholderText="Quận, huyện"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding AddrDistrictVn, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="7"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Tỉnh, thành phố"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding AddrProvinceVn, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource SupplementalInlineLabel}"
                        Text="Tiếng Anh" />
                    <ui:TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Số nhà, đường"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding AddrLineEn, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Row="4"
                        Grid.Column="3"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Xã, phường"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding AddrWardEn, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Row="4"
                        Grid.Column="5"
                        IsEnabled="{Binding DistrictEnabled}"
                        PlaceholderText="Quận, huyện"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding AddrDistrictEn, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Row="4"
                        Grid.Column="7"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Tỉnh, thành phố"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding AddrProvinceEn, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--  Phone/Fax narrower (* 0.7); left edge = Số nhà via SharedSizeGroup.  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SupplementalFieldLabel" />
                        <ColumnDefinition Width="0.7*" MinWidth="0" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="0.7*" MinWidth="0" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource SupplementalInlineLabel}"
                        Text="Liên hệ" />
                    <ui:TextBox
                        Grid.Column="1"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Điện thoại"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Column="3"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="Fax"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Grid.Column="5"
                        IsEnabled="{Binding FieldsLocked, Converter={StaticResource InverseBool}}"
                        PlaceholderText="E-mail"
                        Style="{StaticResource SupplementalFixedTextBox}"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
