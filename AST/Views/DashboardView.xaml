<UserControl
    x:Class="AST.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="{StaticResource AstPagePadding}" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource AstPageTitle}" Text="Bảng điều khiển" />
            <TextBlock Style="{StaticResource AstPageSubtitle}" Text="Tổng quan hệ thống AST." />

            <!--  3 placeholder cards ("Chức năng chờ triển khai") per the Stitch dashboard; real widgets are added later.  -->
            <UniformGrid Margin="0,24,0,0" Columns="3">
                <Border Margin="0,0,12,0" Style="{StaticResource AstCard}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,16,0,0"
                            FontWeight="SemiBold"
                            Style="{StaticResource AstBodyLargeText}"
                            Text="Thẻ 1" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource AstTextSecondaryBrush}"
                            Style="{StaticResource AstBodySmallText}"
                            Text="Chức năng chờ triển khai." />
                    </StackPanel>
                </Border>
                <Border Margin="6,0,6,0" Style="{StaticResource AstCard}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,16,0,0"
                            FontWeight="SemiBold"
                            Style="{StaticResource AstBodyLargeText}"
                            Text="Thẻ 2" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource AstTextSecondaryBrush}"
                            Style="{StaticResource AstBodySmallText}"
                            Text="Chức năng chờ triển khai." />
                    </StackPanel>
                </Border>
                <Border Margin="12,0,0,0" Style="{StaticResource AstCard}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,16,0,0"
                            FontWeight="SemiBold"
                            Style="{StaticResource AstBodyLargeText}"
                            Text="Thẻ 3" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource AstTextSecondaryBrush}"
                            Style="{StaticResource AstBodySmallText}"
                            Text="Chức năng chờ triển khai." />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
