<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Thickness x:Key="AstPagePadding">24</Thickness>
    <Thickness x:Key="AstCardPadding">16</Thickness>
    <!--
        Directional gap tokens for the screen-anatomy spacing mechanism. WPF StackPanel has no Spacing property,
        so consume these via the `Spacing.Between` attached property (AST.UI/Controls/Spacing.cs), not a literal
        margin. Screen-by-screen retrofit onto Spacing.Between is deferred.
    -->
    <sys:Double x:Key="AstSectionGap">24</sys:Double>
    <sys:Double x:Key="AstFieldGap">16</sys:Double>
    <sys:Double x:Key="AstControlPadding">8</sys:Double>
    <sys:Double x:Key="AstContentMaxWidthText">720</sys:Double>
    <!--
        Shape scale: 4 = inputs / small buttons, 8 = cards / dialogs, 12 = featured surfaces. Consume the
        radius token rather than an ad-hoc CornerRadius.
    -->
    <CornerRadius x:Key="AstRadiusInput">4</CornerRadius>
    <CornerRadius x:Key="AstRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="AstRadiusLarge">12</CornerRadius>
</ResourceDictionary>
